# ---------------------------------------------------------------------------
# Lekana - single-host (VM) configuration for docker-compose.yml
# Copy to .env and fill in. Never commit the real .env.
# Per-service variables are documented in docs/configuration.md.
# ---------------------------------------------------------------------------

# Public hostnames (DNS A/AAAA records must point at this VM).
# For a local trial, leave the defaults: https://localhost and https://api.localhost
APP_DOMAIN=localhost
API_DOMAIN=api.localhost

# --- Shared secrets -------------------------------------------------------
# 64 hex chars, identical for every service. Generate: openssl rand -hex 32
# Changing it later makes previously encrypted documents/connection strings unreadable.
ENCRYPTION_KEY=

# Postgres superuser for the bundled database container
POSTGRES_USER=lekana
POSTGRES_PASSWORD=change-me

# --- Clerk (authentication) ------------------------------------------------
# https://dashboard.clerk.com -> API Keys
PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Frontend API domain, e.g. your-app.clerk.accounts.dev or clerk.example.com
CLERK_DOMAIN=

# --- Google AI / Cloud -----------------------------------------------------
GEMINI_API_KEY=
# Bucket for uploaded documents
GCS_BUCKET_NAME=
# Document AI (OCR + optional classification processor)
DOCUMENT_AI_PROJECT_ID=
DOCUMENT_AI_LOCATION=us
DOCUMENT_AI_FORM_PARSER_ID=
DOCUMENT_AI_OCR_PROCESSOR_ID=
DOCUMENT_AI_CLASSIFIER_PROCESSOR_ID=
# A service-account key file is mounted from ./secrets/gcp-service-account.json

# --- Optional ----------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SUPPORT_EMAIL_FROM=
INTERNAL_NOTIFICATION_EMAILS=
PUBLIC_YOUTUBE_TUTORIAL_URL=
PUBLIC_GA_MEASUREMENT_ID=
LOG_NEED=false
