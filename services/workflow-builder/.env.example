# Workflow Builder - copy to .env for local development
PORT=3001

# PostgreSQL database owned by this service (Prisma)
DATABASE_URL=postgresql://lekana:lekana@localhost:5432/workflow_builder?schema=public

# Clerk Frontend API domain, used to verify user JWTs (e.g. your-app.clerk.accounts.dev)
CLERK_DOMAIN=

# 64 hex chars (32 bytes). MUST be identical across all services. Generate: openssl rand -hex 32
ENCRYPTION_KEY=

# Gemini API key - powers the AI workflow builder
GEMINI_API_KEY=

# Optional: outbound email (feedback / role invitations)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SUPPORT_EMAIL_FROM=
INTERNAL_NOTIFICATION_EMAILS=
LOGO_URL=
