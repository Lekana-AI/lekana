generator client {
  provider        = "prisma-client-js"
  output          = "../generated/prisma"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String     @id @default(uuid())
  workflows Workflow[]
}

model Workflow {
  id        String          @id @default(uuid())
  userId    String
  name      String
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  isDeleted Boolean         @default(false)
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  edges     WorkflowEdge[]
  nodes     WorkflowNode[]
  fields    WorkflowField[]
  roles     WorkflowRole[]

  // Publish status tracking (synced from runtime)
  isPublished         Boolean   @default(false)
  publishedWorkflowId String? // Runtime's published workflow ID
  publishedAt         DateTime? // First publish time
  lastPublishedAt     DateTime? // Most recent publish time

  @@index([userId])
}

model WorkflowNode {
  id         String          @id @default(uuid())
  workflowId String
  config     Json
  positionX  Float
  positionY  Float
  actionId   String
  outgoing   WorkflowEdge[]  @relation("SourceEdges")
  incoming   WorkflowEdge[]  @relation("TargetEdges")
  fields     WorkflowField[]
  action     Action          @relation(fields: [actionId], references: [id])
  isDeleted  Boolean         @default(false)
  workflow   Workflow        @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  @@index([workflowId])
  @@index([actionId])
}

model WorkflowEdge {
  id           String       @id @default(uuid())
  workflowId   String
  sourceNodeId String
  targetNodeId String
  sourceNode   WorkflowNode @relation("SourceEdges", fields: [sourceNodeId], references: [id], onDelete: Cascade)
  targetNode   WorkflowNode @relation("TargetEdges", fields: [targetNodeId], references: [id], onDelete: Cascade)
  isDeleted    Boolean      @default(false)
  workflow     Workflow     @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  @@index([workflowId])
}

model ActionCategory {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  actions     Action[]
}

model Action {
  id            String         @id @default(uuid())
  name          String         @unique
  description   String?
  categoryId    String
  configSchema  Json
  configMeta    Json?
  inputType     String?
  outputType    String
  icon          String
  serviceUrl    String?
  category      ActionCategory @relation(fields: [categoryId], references: [id])
  workflowNodes WorkflowNode[]

  @@index([categoryId])
}

model WorkflowField {
  id           String       @id @default(uuid())
  workflowId   String
  sourceNodeId String
  fieldName    String
  fieldPath    String
  fieldType    String?
  createdAt    DateTime     @default(now())
  sourceNode   WorkflowNode @relation(fields: [sourceNodeId], references: [id], onDelete: Cascade)
  workflow     Workflow     @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  @@unique([workflowId, sourceNodeId, fieldName])
  @@index([workflowId])
}

// Available permissions in the system for role-based access control
enum Permission {
  WORKFLOW_VIEW // View workflow structure
  WORKFLOW_EDIT // Edit workflow nodes/edges
  WORKFLOW_PUBLISH // Publish/unpublish workflow
  WORKFLOW_DELETE // Delete workflow
  REVIEW_VIEW // View review queue
  REVIEW_APPROVE // Approve reviewed items
  REVIEW_REJECT // Reject reviewed items
  ROLE_MANAGE // Manage roles and assignments
}

// Role definition with explicit permissions for each workflow
model WorkflowRole {
  id          String                   @id @default(uuid())
  workflowId  String
  name        String // "developer", "validator", custom names
  description String?
  permissions Permission[] // Array of granted permissions
  isSystem    Boolean                  @default(false) // true for developer/validator
  createdAt   DateTime                 @default(now())
  workflow    Workflow                 @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  assignments WorkflowRoleAssignment[]

  @@unique([workflowId, name])
  @@index([workflowId])
}

// Role assignment - links users to roles for specific workflows
model WorkflowRoleAssignment {
  id             String       @id @default(uuid())
  userId         String // Clerk user ID
  userEmail      String? // For display/invite
  workflowRoleId String
  workflowRole   WorkflowRole @relation(fields: [workflowRoleId], references: [id], onDelete: Cascade)
  assignedAt     DateTime     @default(now())
  assignedBy     String? // Who assigned this role

  @@unique([userId, workflowRoleId])
  @@index([userId])
  @@index([workflowRoleId])
}
