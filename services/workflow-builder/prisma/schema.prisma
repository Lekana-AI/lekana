generator client {
  provider        = "prisma-client-js"
  output          = "../generated/prisma"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String     @id @default(uuid())
  feedbacks Feedback[]
  workflows Workflow[]
}

model Workflow {
  id                  String          @id @default(uuid())
  name                String
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
  userId              String
  isPublished         Boolean         @default(false)
  lastPublishedAt     DateTime?
  publishedAt         DateTime?
  publishedWorkflowId String?
  isDeleted           Boolean         @default(false)
  feedbacks           Feedback[]
  user                User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  edges               WorkflowEdge[]
  fields              WorkflowField[]
  nodes               WorkflowNode[]
  roles               WorkflowRole[]

  @@index([userId])
}

model WorkflowNode {
  id         String          @id @default(uuid())
  workflowId String
  config     Json
  positionX  Float
  positionY  Float
  actionId   String
  isDeleted  Boolean         @default(false)
  outgoing   WorkflowEdge[]  @relation("SourceEdges")
  incoming   WorkflowEdge[]  @relation("TargetEdges")
  fields     WorkflowField[]
  action     Action          @relation(fields: [actionId], references: [id])
  workflow   Workflow        @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  @@index([workflowId])
  @@index([actionId])
}

model WorkflowEdge {
  id           String       @id @default(uuid())
  workflowId   String
  sourceNodeId String
  targetNodeId String
  isDeleted    Boolean      @default(false)
  sourceNode   WorkflowNode @relation("SourceEdges", fields: [sourceNodeId], references: [id], onDelete: Cascade)
  targetNode   WorkflowNode @relation("TargetEdges", fields: [targetNodeId], references: [id], onDelete: Cascade)
  workflow     Workflow     @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  @@index([workflowId])
}

model ActionCategory {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  actions     Action[]
}

model Action {
  id            String         @id @default(uuid())
  name          String         @unique
  description   String?
  categoryId    String
  configSchema  Json
  configMeta    Json?
  inputType     String?
  outputType    String
  icon          String
  serviceUrl    String?
  isActive      Boolean        @default(true)
  category      ActionCategory @relation(fields: [categoryId], references: [id])
  workflowNodes WorkflowNode[]

  @@index([categoryId])
}

model WorkflowField {
  id           String       @id @default(uuid())
  workflowId   String
  sourceNodeId String
  fieldName    String
  fieldPath    String
  fieldType    String?
  createdAt    DateTime     @default(now())
  sourceNode   WorkflowNode @relation(fields: [sourceNodeId], references: [id], onDelete: Cascade)
  workflow     Workflow     @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  @@unique([workflowId, sourceNodeId, fieldName])
  @@index([workflowId])
}

model Permission {
  id                     String                   @id @default(uuid())
  code                   String                   @unique
  name                   String
  description            String?
  category               String                   @default("general")
  createdAt              DateTime                 @default(now())
  defaultRolePermissions DefaultRolePermission[]
  rolePermissions        WorkflowRolePermission[]

  @@index([category])
}

model WorkflowRolePermission {
  id             String       @id @default(uuid())
  workflowRoleId String
  permissionId   String
  createdAt      DateTime     @default(now())
  permission     Permission   @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  workflowRole   WorkflowRole @relation(fields: [workflowRoleId], references: [id], onDelete: Cascade)

  @@unique([workflowRoleId, permissionId])
  @@index([workflowRoleId])
  @@index([permissionId])
}

model WorkflowRole {
  id              String                   @id @default(uuid())
  workflowId      String
  name            String
  description     String?
  isSystem        Boolean                  @default(false)
  createdAt       DateTime                 @default(now())
  workflow        Workflow                 @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  assignments     WorkflowRoleAssignment[]
  rolePermissions WorkflowRolePermission[]

  @@unique([workflowId, name])
  @@index([workflowId])
}

model WorkflowRoleAssignment {
  id             String       @id @default(uuid())
  userId         String
  userEmail      String?
  workflowRoleId String
  assignedAt     DateTime     @default(now())
  assignedBy     String?
  workflowRole   WorkflowRole @relation(fields: [workflowRoleId], references: [id], onDelete: Cascade)

  @@unique([userId, workflowRoleId])
  @@index([userId])
  @@index([workflowRoleId])
}

model DefaultRole {
  id                     String                  @id @default(uuid())
  name                   String                  @unique
  description            String?
  isActive               Boolean                 @default(true)
  createdAt              DateTime                @default(now())
  defaultRolePermissions DefaultRolePermission[]
}

model DefaultRolePermission {
  id            String      @id @default(uuid())
  defaultRoleId String
  permissionId  String
  createdAt     DateTime    @default(now())
  defaultRole   DefaultRole @relation(fields: [defaultRoleId], references: [id], onDelete: Cascade)
  permission    Permission  @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([defaultRoleId, permissionId])
  @@index([defaultRoleId])
  @@index([permissionId])
}

model Feedback {
  id              String       @id @default(uuid())
  userId          String
  workflowId      String?
  comment         String
  createdAt       DateTime     @default(now())
  type            FeedbackType @default(GENERAL)
  executionId     String?
  nodeExecutionId String?
  errorDetails    Json?
  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  workflow        Workflow?    @relation(fields: [workflowId], references: [id])

  @@index([userId])
  @@index([workflowId])
}

model UserUsage {
  userId       String   @id
  storageUsed  BigInt   @default(0)
  tokensUsed   BigInt   @default(0)
  storageLimit BigInt   @default(536870912)
  tokenLimit   BigInt?
  updatedAt    DateTime @default(now()) @updatedAt
  createdAt    DateTime @default(now())
}

model SystemConfig {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

enum FeedbackType {
  GENERAL
  ERROR_REPORT
}
