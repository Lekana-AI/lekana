generator client {
  provider        = "prisma-client-js"
  output          = "../generated/prisma"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String     @id @default(uuid())
  workflows Workflow[]
  feedbacks Feedback[]
}

model Workflow {
  id        String          @id @default(uuid())
  userId    String
  name      String
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  isDeleted Boolean         @default(false)
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  edges     WorkflowEdge[]
  nodes     WorkflowNode[]
  fields    WorkflowField[]
  roles     WorkflowRole[]
  feedbacks Feedback[]

  // Publish status tracking (synced from runtime)
  isPublished         Boolean   @default(false)
  publishedWorkflowId String? // Runtime's published workflow ID
  publishedAt         DateTime? // First publish time
  lastPublishedAt     DateTime? // Most recent publish time

  @@index([userId])
}

model WorkflowNode {
  id         String          @id @default(uuid())
  workflowId String
  config     Json
  positionX  Float
  positionY  Float
  actionId   String
  outgoing   WorkflowEdge[]  @relation("SourceEdges")
  incoming   WorkflowEdge[]  @relation("TargetEdges")
  fields     WorkflowField[]
  action     Action          @relation(fields: [actionId], references: [id])
  isDeleted  Boolean         @default(false)
  workflow   Workflow        @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  @@index([workflowId])
  @@index([actionId])
}

model WorkflowEdge {
  id           String       @id @default(uuid())
  workflowId   String
  sourceNodeId String
  targetNodeId String
  sourceNode   WorkflowNode @relation("SourceEdges", fields: [sourceNodeId], references: [id], onDelete: Cascade)
  targetNode   WorkflowNode @relation("TargetEdges", fields: [targetNodeId], references: [id], onDelete: Cascade)
  isDeleted    Boolean      @default(false)
  workflow     Workflow     @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  @@index([workflowId])
}

model ActionCategory {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  actions     Action[]
}

model Action {
  id            String         @id @default(uuid())
  name          String         @unique
  description   String?
  categoryId    String
  configSchema  Json
  configMeta    Json?
  inputType     String?
  outputType    String
  icon          String
  serviceUrl    String?
  category      ActionCategory @relation(fields: [categoryId], references: [id])
  workflowNodes WorkflowNode[]

  @@index([categoryId])
}

model WorkflowField {
  id           String       @id @default(uuid())
  workflowId   String
  sourceNodeId String
  fieldName    String
  fieldPath    String
  fieldType    String?
  createdAt    DateTime     @default(now())
  sourceNode   WorkflowNode @relation(fields: [sourceNodeId], references: [id], onDelete: Cascade)
  workflow     Workflow     @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  @@unique([workflowId, sourceNodeId, fieldName])
  @@index([workflowId])
}

// Available permissions in the system for role-based access control
model Permission {
  id                     String                   @id @default(uuid())
  code                   String                   @unique // e.g., "WORKFLOW_VIEW"
  name                   String // e.g., "View Workflow"
  description            String? // Detailed description
  category               String                   @default("general") // e.g., "workflow", "review", "admin"
  createdAt              DateTime                 @default(now())
  rolePermissions        WorkflowRolePermission[]
  defaultRolePermissions DefaultRolePermission[]

  @@index([category])
}

// Junction table linking WorkflowRole to Permission
model WorkflowRolePermission {
  id             String       @id @default(uuid())
  workflowRoleId String
  permissionId   String
  workflowRole   WorkflowRole @relation(fields: [workflowRoleId], references: [id], onDelete: Cascade)
  permission     Permission   @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())

  @@unique([workflowRoleId, permissionId])
  @@index([workflowRoleId])
  @@index([permissionId])
}

// Role definition with explicit permissions for each workflow
model WorkflowRole {
  id              String                   @id @default(uuid())
  workflowId      String
  name            String // "developer", "validator", custom names
  description     String?
  isSystem        Boolean                  @default(false) // true for developer/validator
  createdAt       DateTime                 @default(now())
  workflow        Workflow                 @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  assignments     WorkflowRoleAssignment[]
  rolePermissions WorkflowRolePermission[]

  @@unique([workflowId, name])
  @@index([workflowId])
}

// Role assignment - links users to roles for specific workflows
model WorkflowRoleAssignment {
  id             String       @id @default(uuid())
  userId         String // Clerk user ID
  userEmail      String? // For display/invite
  workflowRoleId String
  workflowRole   WorkflowRole @relation(fields: [workflowRoleId], references: [id], onDelete: Cascade)
  assignedAt     DateTime     @default(now())
  assignedBy     String? // Who assigned this role

  @@unique([userId, workflowRoleId])
  @@index([userId])
  @@index([workflowRoleId])
}

// Default role templates - automatically created for each new workflow
model DefaultRole {
  id                     String                  @id @default(uuid())
  name                   String                  @unique // e.g., "developer", "validator"
  description            String?
  isActive               Boolean                 @default(true) // Can disable without deleting
  createdAt              DateTime                @default(now())
  defaultRolePermissions DefaultRolePermission[]
}

// Junction table linking DefaultRole to Permission
model DefaultRolePermission {
  id            String      @id @default(uuid())
  defaultRoleId String
  permissionId  String
  defaultRole   DefaultRole @relation(fields: [defaultRoleId], references: [id], onDelete: Cascade)
  permission    Permission  @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  createdAt     DateTime    @default(now())

  @@unique([defaultRoleId, permissionId])
  @@index([defaultRoleId])
  @@index([permissionId])
}

model Feedback {
  id         String   @id @default(uuid())
  userId     String
  workflowId String?
  comment    String
  createdAt  DateTime @default(now())

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workflow Workflow? @relation(fields: [workflowId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([workflowId])
}
