generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String     @id @default(uuid())
  email     String     @unique
  name      String?
  workflows Workflow[]
}

model Workflow {
  id        String         @id @default(uuid())
  userId    String
  name      String
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  edges     WorkflowEdge[]
  nodes     WorkflowNode[]

  @@index([userId])
}

model WorkflowNode {
  id         String         @id @default(uuid())
  workflowId String
  actionId   String
  positionX  Float
  positionY  Float
  config     Json
  outgoing   WorkflowEdge[] @relation("SourceEdges")
  incoming   WorkflowEdge[] @relation("TargetEdges")
  action     Action         @relation(fields: [actionId], references: [id])
  workflow   Workflow       @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  @@index([workflowId])
  @@index([actionId])
}

model WorkflowEdge {
  id           String       @id @default(uuid())
  workflowId   String
  sourceNodeId String
  targetNodeId String
  sourceNode   WorkflowNode @relation("SourceEdges", fields: [sourceNodeId], references: [id], onDelete: Cascade)
  targetNode   WorkflowNode @relation("TargetEdges", fields: [targetNodeId], references: [id], onDelete: Cascade)
  workflow     Workflow     @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  @@index([workflowId])
}

model ActionCategory {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  actions     Action[]
}

model Action {
  id            String         @id @default(uuid())
  name          String         @unique
  description   String?
  icon          String         // Icon name for frontend: "CloudUpload", "FileText", etc.
  categoryId    String
  inputType     String?        // Input data type: "file", "json", "text", "any", null (start node)
  outputType    String         // Output data type: "file", "json", "text"
  configSchema  Json           // Default values: { stepName: "API Call", method: "GET" }
  configMeta    Json?          // Field metadata: { stepName: { type: "text", label: "Step Name" } }
  category      ActionCategory @relation(fields: [categoryId], references: [id])
  workflowNodes WorkflowNode[]

  @@index([categoryId])
}
