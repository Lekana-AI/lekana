generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String     @id @default(uuid())
  email     String     @unique
  name      String?
  workflows Workflow[]
}

model Workflow {
  id        String         @id @default(uuid())
  userId    String
  name      String
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  edges     WorkflowEdge[]
  nodes     WorkflowNode[]
  fields    WorkflowField[]

  // Publish status tracking (synced from runtime)
  isPublished           Boolean   @default(false)
  publishedWorkflowId   String?   // Runtime's published workflow ID
  publishedAt           DateTime? // First publish time
  lastPublishedAt       DateTime? // Most recent publish time

  @@index([userId])
}

model WorkflowNode {
  id         String         @id @default(uuid())
  workflowId String
  actionId   String
  positionX  Float
  positionY  Float
  config     Json
  outgoing   WorkflowEdge[] @relation("SourceEdges")
  incoming   WorkflowEdge[] @relation("TargetEdges")
  action     Action         @relation(fields: [actionId], references: [id])
  workflow   Workflow       @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  fields     WorkflowField[]

  @@index([workflowId])
  @@index([actionId])
}

model WorkflowEdge {
  id           String       @id @default(uuid())
  workflowId   String
  sourceNodeId String
  targetNodeId String
  sourceNode   WorkflowNode @relation("SourceEdges", fields: [sourceNodeId], references: [id], onDelete: Cascade)
  targetNode   WorkflowNode @relation("TargetEdges", fields: [targetNodeId], references: [id], onDelete: Cascade)
  workflow     Workflow     @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  @@index([workflowId])
}

model ActionCategory {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  actions     Action[]
}

model Action {
  id            String         @id @default(uuid())
  name          String         @unique
  description   String?
  icon          String         // Icon name for frontend: "CloudUpload", "FileText", etc.
  categoryId    String
  inputType     String?        // Input data type: "file", "json", "text", "any", null (start node)
  outputType    String         // Output data type: "file", "json", "text"
  serviceUrl    String?        // Microservice URL: "http://localhost:4002" - used by runtime
  configSchema  Json           // Default values: { stepName: "API Call", method: "GET" }
  configMeta    Json?          // Field metadata: { stepName: { type: "text", label: "Step Name" } }
  category      ActionCategory @relation(fields: [categoryId], references: [id])
  workflowNodes WorkflowNode[]

  @@index([categoryId])
}

// Global registry of fields available in a workflow
// Auto-populated when nodes (like OCR) are configured with output fields
model WorkflowField {
  id           String       @id @default(uuid())
  workflowId   String
  sourceNodeId String
  fieldName    String       // e.g., "invoice_no"
  fieldPath    String       // Full path: "documents[].result.invoice_no"
  fieldType    String?      // "string", "number", "boolean", "object"
  createdAt    DateTime     @default(now())

  workflow     Workflow     @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  sourceNode   WorkflowNode @relation(fields: [sourceNodeId], references: [id], onDelete: Cascade)

  @@unique([workflowId, sourceNodeId, fieldName])
  @@index([workflowId])
}
