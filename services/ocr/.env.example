# OCR service - copy to .env for local development
PORT=4004

# Google Document AI
DOCUMENT_AI_PROJECT_ID=
DOCUMENT_AI_LOCATION=us
DOCUMENT_AI_FORM_PARSER_ID=
DOCUMENT_AI_OCR_PROCESSOR_ID=

# Credentials: either inline JSON, or GOOGLE_APPLICATION_CREDENTIALS pointing to a key file
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_APPLICATION_CREDENTIALS=./service-account.json

GEMINI_API_KEY=
CLERK_DOMAIN=
