# Classification service - copy to .env for local development
PORT=4002
NODE_ENV=development
SERVICE_VERSION=1.0.0

MONGODB_URI=mongodb://localhost:27017/lekana_classification
GEMINI_API_KEY=

# Optional: Google Document AI classifier (falls back to Gemini when unset)
GOOGLE_CLOUD_PROJECT_ID=
GOOGLE_CLOUD_LOCATION=us
GOOGLE_CLOUD_PROCESSOR_ID=
GOOGLE_SERVICE_ACCOUNT_JSON=

CONFIDENCE_THRESHOLD=0.7
CORS_ORIGIN=*
# 64 hex chars. MUST be identical across all services.
ENCRYPTION_KEY=
