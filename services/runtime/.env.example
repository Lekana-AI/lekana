# Runtime (workflow execution engine) - copy to .env for local development
PORT=3002

# PostgreSQL database owned by this service (Prisma)
DATABASE_URL=postgresql://lekana:lekana@localhost:5432/runtime?schema=public

# Read-only access to the workflow-builder database, used to resolve Action.serviceUrl at run time
WORKFLOW_DB_URL=postgresql://lekana:lekana@localhost:5432/workflow_builder?schema=public

# Internal URLs of other services
WORKFLOW_API=http://localhost:3001
UPLOAD_SERVICE_URL=http://localhost:4001

# Clerk Frontend API domain, used to verify user JWTs
CLERK_DOMAIN=

# 64 hex chars. MUST be identical across all services.
ENCRYPTION_KEY=

# Verbose request/response logging (true/false)
LOG_NEED=false
