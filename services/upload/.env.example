# Upload service - copy to .env for local development
PORT=4001

# Google Cloud Storage bucket for uploaded documents
GCS_BUCKET_NAME=
SIGNED_URL_EXPIRY_MINUTES=60

# Path to a service-account key with Storage Object Admin + Service Account Token Creator
# (not needed on Cloud Run / GCE, which use the attached service account)
GOOGLE_APPLICATION_CREDENTIALS=./service-account.json

CLERK_DOMAIN=
# 64 hex chars. MUST be identical across all services. Leave empty to store files unencrypted.
ENCRYPTION_KEY=
