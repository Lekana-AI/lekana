# Lekana → Vercel environment
#
#   cp deploy/vercel.env.example deploy/vercel.env   (deploy/vercel.env is git-ignored)
#
# [shared] values go to every service that lists the key in deploy/services.json.
# [<service id>] values apply to that service only and override [shared].
# Values are single-line. Wrap JSON in single quotes. Empty values are skipped.
# Service-to-service URLs (WORKFLOW_API, RUNTIME_BASE, ...) are filled in
# automatically by scripts/deploy-vercel.mjs; don't set them here.

[shared]
CLERK_DOMAIN=your-app.clerk.accounts.dev
# 32-byte hex string (64 chars): node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=
GEMINI_API_KEY=
# Full GCP service-account key JSON on ONE line (Document AI + Cloud Storage access)
GOOGLE_SERVICE_ACCOUNT_JSON='{"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}'
# Postgres used by workflow-builder AND runtime (e.g. Neon). Use the pooled URL.
DATABASE_URL=postgresql://user:password@host/db?sslmode=require

[upload]
GCS_BUCKET_NAME=lekana-uploads
SIGNED_URL_EXPIRY_MINUTES=60

[ocr]
DOCUMENT_AI_PROJECT_ID=
DOCUMENT_AI_LOCATION=us
DOCUMENT_AI_OCR_PROCESSOR_ID=
DOCUMENT_AI_FORM_PARSER_ID=

[classification]
MONGODB_URI=mongodb+srv://user:password@cluster/db
GOOGLE_CLOUD_PROJECT_ID=
GOOGLE_CLOUD_LOCATION=us
GOOGLE_CLOUD_PROCESSOR_ID=
CONFIDENCE_THRESHOLD=0.7
CORS_ORIGIN=*

[workflow-builder]
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SUPPORT_EMAIL_FROM=
INTERNAL_NOTIFICATION_EMAILS=
LOGO_URL=

[runtime]
# Read access to the workflow-builder database (usually same as DATABASE_URL above)
WORKFLOW_DB_URL=
LOG_NEED=false

[web]
PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
PUBLIC_YOUTUBE_TUTORIAL_URL=
ENTERPRISE_BASE=
ENTERPRISE_TOKEN=
