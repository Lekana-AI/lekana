# Cloud Run deployment settings - copy to deploy/cloudrun/config.env
# Secrets are NOT stored here; they live in Secret Manager (see docs/deploy-serverless.md).

PROJECT_ID=your-gcp-project
REGION=europe-west1
ARTIFACT_REPO=lekana

# Non-secret service configuration
CLERK_DOMAIN=your-app.clerk.accounts.dev
PUBLIC_CLERK_PUBLISHABLE_KEY=pk_live_xxx
GCS_BUCKET_NAME=your-lekana-uploads
DOCUMENT_AI_LOCATION=us
DOCUMENT_AI_FORM_PARSER_ID=
DOCUMENT_AI_OCR_PROCESSOR_ID=
DOCUMENT_AI_CLASSIFIER_PROCESSOR_ID=
PUBLIC_YOUTUBE_TUTORIAL_URL=
PUBLIC_GA_MEASUREMENT_ID=

# Optional: Cloud SQL instance connection name (PROJECT:REGION:INSTANCE).
# When set, services get the Cloud SQL socket mounted at /cloudsql/<name>, and your
# DATABASE_URL secrets should use ?host=/cloudsql/<name>. Leave empty for Neon, Supabase, etc.
CLOUDSQL_INSTANCE=

# Optional: custom domain for the web app (otherwise the *.run.app URL is used)
WEB_ORIGIN=
