# Web app (SvelteKit) - copy to .env for local development

# Clerk (https://dashboard.clerk.com -> API Keys)
PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Server-side proxy targets (never exposed to the browser)
WORKFLOW_BASE=http://localhost:3001
RUNTIME_BASE=http://localhost:3002

# Public URL of the runtime API, shown to users for API calls (e.g. https://api.example.com)
PUBLIC_API_URL=http://localhost:3002

# Optional
PUBLIC_YOUTUBE_TUTORIAL_URL=
PUBLIC_GA_MEASUREMENT_ID=
ENTERPRISE_BASE=
ENTERPRISE_TOKEN=

# Only for `vite dev` behind a tunnel, comma-separated
VITE_ALLOWED_HOSTS=
